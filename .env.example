APP_NAME="Travel Company"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONT_APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=daily

# --- Identité de l'agence (config/agency.php) ---
AGENCY_NAME="Travel Company"
AGENCY_DOMAIN=example.com
AGENCY_LOGO=
AGENCY_ORIGIN_COUNTRY=France
AGENCY_ADMIN_EMAIL=admin@example.com
AGENCY_PAYMENTS_EMAIL=payments@example.com
AGENCY_ALERTS_EMAIL=alerts@example.com
# Listes séparées par des virgules
AGENCY_RESERVATION_EMAILS=reservations@example.com
AGENCY_EMISSION_EMAILS=emission@example.com
AGENCY_EMISSION_PHONES=

# Proxys de confiance si le site est derrière un load balancer (ex. *)
TRUSTED_PROXIES=

# Front public (API) autorisé en CORS, séparé par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=travel_company
DB_USERNAME=root
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# En production avec le front sur un autre domaine : SESSION_SAME_SITE=none et SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${AGENCY_NAME}"

# --- Paiement Paybox / Verifone ---
PAYBOX_URL=
# Serveur de la page de paiement agent (préproduction : preprod-tpeweb.paybox.com)
PAYBOX_DOMAIN=tpeweb.paybox.com
PAYBOX_SITE=
PAYBOX_RANK=
PAYBOX_ID=
PAYBOX_HMAC_KEY=
# Clé publique Paybox (à télécharger depuis la documentation Paybox), vérifie les retours de paiement
PAYBOX_PUBLIC_KEY=

# --- SMS iSendPro ---
ISENDPROID=
ISENDPROEMETTEUR=

# --- API Amadeus (recherche de vols) ---

# --- Auth API (front public) ---
JWT_SECRET=
JWT_TTL=120

APP_LOCALE=fr
